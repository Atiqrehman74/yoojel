# ============================================================
#  YOOJEL CHAT — Environment Variables
# ============================================================

# REQUIRED: Your Anthropic (Claude) API key.
# Get one at https://console.anthropic.com  ->  Settings  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: Default model. See lib/models.ts for the full list.
# Leave as-is for a good balance of quality + cost.
DEFAULT_MODEL=claude-sonnet-4-6

# OPTIONAL — IMAGE + VIDEO GENERATION (Pro feature)
# Powers /api/image and /api/video via Muapi.ai's gateway (nano-banana for
# images, Wan 2.1 for video). Get a key at https://muapi.ai
MUAPI_KEY=

# Supabase — supabase.com -> project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe — dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OPTIONAL — powers the "Yoojel X (Beta)" model only (routesme.online gateway)
ROUTESME_API_KEY=rm-...

# OPTIONAL — outbound email for lead-form notifications (Corporate/MovieMaker)
# Get a key at https://resend.com -- no domain verification needed, uses
# their shared onboarding@resend.dev sender by default.
RESEND_API_KEY=re_...
RESEND_FROM=

# OPTIONAL — YOOJEL CODER (Pro feature)
# Powers /api/coder via api.b.ai (OpenAI-compatible gateway, model
# gpt-5.2). Neither deepseek-harness nor OmniRoute -- the two repos
# suggested as "the real backend" -- expose a hosted API; both are
# local-only tools, so a real hosted gateway is used instead.
BAI_API_KEY=sk-...
